# Debug Assistant Backend Configuration
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_32_PLUS_RANDOM_BYTES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SQLite (default, zero config)
DATABASE_URL=sqlite:///./debug_assistant.db
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:8000

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
